<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".md" />
            <mimeMap fileExtension=".md" mimeType="text/markdown" />
        </staticContent>

        <rewrite>
            <rules>
                <rule name="Escludi statistiche Plesk e verifiche SSL" stopProcessing="true">
                    <match url="^(?:plesk-stat|\.well-known)(?:/|$)" ignoreCase="true" />
                    <action type="None" />
                </rule>

                <!-- Il vecchio prefisso arriva al dominio definitivo in un solo passaggio. -->
                <rule name="Rimuovi prefisso car3001" stopProcessing="true">
                    <match url="^car3001(?:/|$)(.*)$" ignoreCase="true" />
                    <action type="Redirect" url="https://car3001.it/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <rule name="Usa HTTPS senza www" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
                        <add input="{HTTP_HOST}" pattern="^www\.car3001\.it(?::[0-9]+)?$" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect" url="https://car3001.it/{R:1}" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <rule name="Servi il sito da docs" stopProcessing="true">
                    <match url="^((?!(?:docs|plesk-stat|\.well-known)(?:/|$)).*)$" ignoreCase="true" />
                    <action type="Rewrite" url="docs/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
