<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Imposta index.html come documento predefinito -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>

        <!-- Sblocca i tipi MIME su IIS per immagini WebP, JSON e Markdown -->
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".md" />
            <mimeMap fileExtension=".md" mimeType="text/markdown" />
        </staticContent>

        <rewrite>
            <rules>
                <!-- 1. Se arriva una richiesta con il vecchio prefisso /car3001/, lo rimuove -->
                <rule name="Rimuovi prefisso car3001" stopProcessing="false">
                    <match url="^car3001/(.*)$" />
                    <action type="Rewrite" url="{R:1}" />
                </rule>

                <!-- 2. Instrada tutte le richieste verso la cartella /docs/ del repository -->
                <rule name="Reindirizza a docs" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_URI}" pattern="^/docs/" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="docs/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
