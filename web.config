<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 1. Rimuove il prefisso /car3001/ dagli asset e dalle pagine -->
                <rule name="Rimuovi prefisso car3001" stopProcessing="false">
                    <match url="^car3001/(.*)$" />
                    <action type="Rewrite" url="{R:1}" />
                </rule>

                <!-- 2. Instrada tutte le richieste verso la sottocartella /docs/ -->
                <rule name="Reindirizza alla sottocartella" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_URI}" pattern="^/docs/" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="docs/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
